# Variables mini-rag reads from your shell environment. This file is not loaded automatically.
# The first group can also be set per project in .mini-rag/config.env.
RAG_LLM_MODEL=qwen3.5:9b-mlx
RAG_EMBEDDING_MODEL=nomic-embed-text-v2-moe
RAG_CHUNK_SIZE=400
# Overlap defaults to 15% of the chunk size:
# RAG_CHUNK_OVERLAP=60
RAG_TOP_K=5
# dense = vectors only; hybrid = vectors + BM25 keyword search fused with RRF
RAG_RETRIEVAL=hybrid
# Rescore the top 10 candidates with the chat model: better order, ~1s extra per candidate
RAG_RERANK=false
# Let the chat model reason before answering: much slower
RAG_THINK=false
# Context window requested from Ollama for answer generation
RAG_NUM_CTX=8192

# Environment or command line only (ignored in a project's config.env)
RAG_OLLAMA_HOST=http://localhost:11434
RAG_COLLECTION_NAME=documents
